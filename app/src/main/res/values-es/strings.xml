    <string name="about_title">Acerca de Roadscript</string>
    <string name="about_desc_long">Su compañero de carretera esencial para gestionar el historial de su vehículo. Siga su mantenimiento, consumo y gastos con facilidad. Permite importar y exportar todos sus datos para una copia de seguridad segura.</string>
