    <!-- About -->
    <string name="about_title">About Roadscript</string>
    <string name="about_desc_long">Your essential road companion to centralize and manage your vehicle\'s complete history. Track your interventions, archive your important documents and always keep an eye on your digital maintenance log. The application allows you to import and export all of your data to your smartphone or computer for peaceful backup.</string>
    <string name="about_full_version">Licensed under GPLv3</string>
    <string name="about_author">Author: Christophe Savary (Smartoweb) + AI</string>
    <string name="about_contact">Contact: roadscript@smartoweb.com</string>
    <string name="about_privacy">Privacy: This application works exclusively locally on your smartphone. It does not collect, store or transmit any personal or technical information to third parties. Your data remains your exclusive property.</string>
    <string name="about_disclaimer">This application is provided \'as is\', it does not replace any official document and like any computer program may malfunction. By using it, you accept full responsibility for your use of it. The data export functionality it contains is, by running it regularly, the best protection against data corruption or application malfunction that may occur.</string>
    <string name="about_storage_path">Data storage location:</string>

