    <!-- About -->
    <string name="about_title">Sobre o Roadscript</string>
    <string name="about_desc_long">O seu companheiro de estrada essencial para gerir o histórico do seu veículo. Acompanhe a manutenção, consumos e gastos com facilidade. Suporta cópias de segurança seguras via importação e exportação.</string>
    <string name="about_full_version">Sob licença GPLv3</string>
    <string name="about_author">Autor: Christophe Savary (Smartoweb) + IA</string>
    <string name="about_contact">Contacto: roadscript@smartoweb.com</string>
    <string name="about_privacy">Privacité: Funciona localmente no seu smartphone. Não recolhe nem transmite informações pessoais. Os seus données sont de sua propriedade exclusiva.</string>
    <string name="about_disclaimer">Esta aplicação é fornecida \'tal como está\', não substitui qualquer documento oficial et, comme qualquer programa informático, pode apresentar anomalias. Ao utilizá-la, aceita a total responsabilité pela utilização que dela fizer. A funcionalidade d\'exportação de dados nela contida é, executando-a regularmente, a melhor proteção contra a corrupção de dados ou anomalias da aplicação que possam ocorrer.</string>
    <string name="about_storage_path">Localização dos dados:</string>

